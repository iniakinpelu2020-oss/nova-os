{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NOVA // OS",
  "version": "1.0.0",
  "identifier": "com.novaos.desktop",
  "build": {
    "frontendDist": "https://nova-os-9ed.pages.dev",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "NOVA // OS",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.png"]
  },
  "plugins": {
    "global-shortcut": {},
    "single-instance": {},
    "autostart": {},
    "shell": {}
  }
}